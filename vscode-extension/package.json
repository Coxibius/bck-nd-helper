{
  "name": "bck-nd-vscode",
  "displayName": "Backend Helper",
  "description": "Four Pillars and Requirements Intelligence integration for bck-nd-hlpr",
  "version": "1.1.0",
  "publisher": "coxibius",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coxibius/bck-nd-helper.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:backendHelperView.controlPanel",
    "onCommand:bck-nd-hlpr.reqList",
    "onCommand:bck-nd-hlpr.reqInit",
    "onCommand:bck-nd-hlpr.reqDiscover",
    "onCommand:bck-nd-hlpr.copyContext"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "backendHelperView",
          "title": "Backend Helper",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "backendHelperView": [
        {
          "type": "webview",
          "id": "backendHelperView.controlPanel",
          "name": "BCK-ND: Control Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "bck-nd.generateDiagram",
        "title": "Backend Helper: Generate Architecture Diagram"
      },
      {
        "command": "bck-nd-hlpr.reqList",
        "title": "Backend Helper: List Requirements"
      },
      {
        "command": "bck-nd-hlpr.reqInit",
        "title": "Backend Helper: Create New User Story"
      },
      {
        "command": "bck-nd-hlpr.reqDiscover",
        "title": "Backend Helper: Discover User Story"
      },
      {
        "command": "bck-nd-hlpr.copyContext",
        "title": "Backend Helper: Copy AI Context to Clipboard"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.1.3"
  }
}
