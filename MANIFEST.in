# Include documentation
include README.md
include ROADMAP.txt
include IA-context.md
include LICENSE

# Exclude virtual environments and build artifacts
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
prune venv
prune env
prune */venv
prune */env
prune .venv
prune build
prune dist
prune *.egg-info

prune vscode-extension
