# Include documentation

include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml

# Excluir explícitamente todo lo de VS Code para mantener el paquete PyPI ligero
recursive-exclude vscode-extension *.vsix
prune vscode-extension/node_modules
recursive-exclude vscode-extension *
recursive-exclude mis_apuntes *
recursive-exclude tests *

# Exclude local Backend Helper runtime cache while preserving project metadata sources
prune .bck-nd/cache
recursive-exclude .bck-nd/cache *

# Exclude virtual environments and build artifacts
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
prune venv
prune env
prune */venv
prune */env
prune .venv
prune build
prune dist
prune *.egg-info

prune vscode-extension
